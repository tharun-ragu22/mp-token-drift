{
  "name": "mp-token-drift",
  "version": "1.0.0",
  "description": "CLI for detecting design system token drift via AST analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mp-token-drift": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "scan": "node dist/index.js scan",
    "scan:json": "node dist/index.js scan --format json",
    "scan:sarif": "node dist/index.js scan --format sarif --out drift-report.sarif",
    "scan:ci": "node dist/index.js scan --format sarif --fail-on-drift --out drift-report.sarif",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/evals/agentEval.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/culori": "^4.0.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.114",
    "@ai-sdk/google": "^3.0.118",
    "@ai-sdk/openai": "^3.0.104",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "ai": "^6.0.271",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "magic-string": "^1.2.3",
    "ollama-ai-provider-v2": "^3.6.0",
    "zod": "^4.5.1"
  }
}
