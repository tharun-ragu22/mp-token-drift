{
  "name": "mp-token-drift",
  "version": "1.0.0",
  "description": "CLI for detecting design system token drift via AST analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mp-token-drift": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "scan": "node dist/index.js scan",
    "scan:json": "node dist/index.js scan --format json",
    "scan:ci": "node dist/index.js scan --format sarif --fail-on-drift",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "culori": "^4.0.2",
    "glob": "^13.0.6",
    "zod": "^4.4.3"
  }
}
